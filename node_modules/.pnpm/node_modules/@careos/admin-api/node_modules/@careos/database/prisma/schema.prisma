generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}


enum RoleName {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  HOSPITAL_STAFF
  PLATFORM_ADMIN
  SUPER_ADMIN
}


enum HospitalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum AppointmentType {
  IN_PERSON
  TELECONSULT
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum OrgStaffRole {
  HOSPITAL_ADMIN
  RECEPTIONIST
  NURSE
  DOCTOR_COORDINATOR
}
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityAppointmentType {
  IN_PERSON
  TELECONSULT
  BOTH
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  primaryRole  RoleName   @map("primary_role")
  lastLoginAt  DateTime?  @map("last_login_at")

  userRoles    UserRole[]
  patient      Patient?
doctor       Doctor?
  orgStaff     OrgStaff[]
  auditLogs    AuditLog[]

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  userRoles   UserRole[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid())

  userId String @map("user_id")
  roleId String @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Address {
  id         String  @id @default(uuid())

  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String? @map("postal_code")
  country    String
  latitude   Float?
  longitude  Float?

  patients   Patient[]
  hospitals  Hospital[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("addresses")
}

model Patient {
  id                    String    @id @default(uuid())

  userId                String    @unique @map("user_id")
  fullName              String    @map("full_name")
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?
  phone                 String?
  primaryAddressId      String?   @map("primary_address_id")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  medicalHistory        String?   @map("medical_history")
  allergies             String?
  currentMedications    String?   @map("current_medications")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAddress        Address?  @relation(fields: [primaryAddressId], references: [id])

  appointments Appointment[]
encounters             Encounter[]
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@map("patients")
}

model Hospital {
  id            String         @id @default(uuid())

  name          String
  legalName     String?        @map("legal_name")
  addressId     String?        @map("address_id")
  contactPhone  String?        @map("contact_phone")
  contactEmail  String?        @map("contact_email")
  licenseNumber String?        @map("license_number")
  status        HospitalStatus @default(PENDING)
  timeZone      String?        @map("time_zone")

  address       Address?       @relation(fields: [addressId], references: [id])
  departments   HospitalDepartment[]
  doctors       HospitalDoctor[]
  staff         OrgStaff[]
appointments Appointment[]
encounters    Encounter[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@map("hospitals")
}

model HospitalDepartment {
  id          String    @id @default(uuid())

  hospitalId  String    @map("hospital_id")
  name        String
  description String?

  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors     HospitalDoctor[]
appointments Appointment[]
encounters Encounter[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([hospitalId, name])
  @@map("hospital_departments")
}

model Doctor {
  id              String   @id @default(uuid())

  fullName        String   @map("full_name")
  specialization  String?
  licenseNumber   String?  @map("license_number")
  yearsExperience Int?     @map("years_experience")
  bio             String?
  consultationFee Decimal? @map("consultation_fee")
userId String? @unique @map("user_id")
user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  hospitals       HospitalDoctor[]
appointments Appointment[]
encounters    Encounter[]

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@map("doctors")
}

model HospitalDoctor {
  id           String   @id @default(uuid())

  hospitalId   String   @map("hospital_id")
  doctorId     String   @map("doctor_id")
  departmentId String?  @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")

  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   HospitalDepartment? @relation(fields: [departmentId], references: [id])
 
  availabilities DoctorAvailability[]
appointments Appointment[]
encounters     Encounter[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([hospitalId, doctorId])
  @@map("hospital_doctors")
}

model DoctorAvailability {
  id                  String                      @id @default(uuid())

  hospitalDoctorId    String                      @map("hospital_doctor_id")
  dayOfWeek           DayOfWeek                   @map("day_of_week")
  startTime           String                      @map("start_time")
  endTime             String                      @map("end_time")
  slotDurationMinutes Int                         @default(30) @map("slot_duration_minutes")
  appointmentType     AvailabilityAppointmentType @default(BOTH) @map("appointment_type")
  isActive            Boolean                     @default(true) @map("is_active")

  hospitalDoctor      HospitalDoctor              @relation(fields: [hospitalDoctorId], references: [id], onDelete: Cascade)

  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  deletedAt           DateTime?                   @map("deleted_at")

  @@index([hospitalDoctorId, dayOfWeek])
  @@map("doctor_availabilities")
}

model Appointment {
  id                String            @id @default(uuid())

  patientId         String            @map("patient_id")
  hospitalId        String            @map("hospital_id")
  hospitalDoctorId  String            @map("hospital_doctor_id")
  doctorId          String            @map("doctor_id")
  departmentId      String?           @map("department_id")

  appointmentType   AppointmentType   @map("appointment_type")
  scheduledDate     DateTime          @map("scheduled_date")
  scheduledStart    DateTime          @map("scheduled_start")
  scheduledEnd      DateTime          @map("scheduled_end")

  status            AppointmentStatus @default(REQUESTED)
  reason            String?
  cancellationReason String?          @map("cancellation_reason")

  patient           Patient           @relation(fields: [patientId], references: [id])
  hospital          Hospital          @relation(fields: [hospitalId], references: [id])
  hospitalDoctor    HospitalDoctor    @relation(fields: [hospitalDoctorId], references: [id])
  doctor            Doctor            @relation(fields: [doctorId], references: [id])
  department        HospitalDepartment? @relation(fields: [departmentId], references: [id])
encounter         Encounter?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  @@index([patientId])
  @@index([hospitalId])
  @@index([hospitalDoctorId])
  @@index([scheduledStart, scheduledEnd])
  @@map("appointments")
}
model Encounter {
  id                   String              @id @default(uuid())

  appointmentId         String              @unique @map("appointment_id")
  patientId             String              @map("patient_id")
  hospitalId            String              @map("hospital_id")
  hospitalDoctorId      String              @map("hospital_doctor_id")
  doctorId              String              @map("doctor_id")
  departmentId          String?             @map("department_id")

  chiefComplaint        String?             @map("chief_complaint")
  notes                 String?
  diagnosis             String?
  prescription          String?
  followUpInstructions  String?             @map("follow_up_instructions")

  appointment           Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient               Patient             @relation(fields: [patientId], references: [id])
  hospital              Hospital            @relation(fields: [hospitalId], references: [id])
  hospitalDoctor        HospitalDoctor      @relation(fields: [hospitalDoctorId], references: [id])
  doctor                Doctor              @relation(fields: [doctorId], references: [id])
  department            HospitalDepartment? @relation(fields: [departmentId], references: [id])

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  deletedAt             DateTime?           @map("deleted_at")

  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorId])
  @@index([appointmentId])
  @@map("encounters")
}
model OrgStaff {
  id         String       @id @default(uuid())

  userId     String       @map("user_id")
  hospitalId String       @map("hospital_id")
  staffRole  OrgStaffRole @map("staff_role")
  isActive   Boolean      @default(true) @map("is_active")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([userId, hospitalId])
  @@map("org_staff")
}

model AuditLog {
  id         String   @id @default(uuid())

  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?

  user       User?    @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}