generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum RoleName {
  PATIENT
  HOSPITAL_ADMIN
  HOSPITAL_STAFF
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum HospitalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum OrgStaffRole {
  HOSPITAL_ADMIN
  RECEPTIONIST
  NURSE
  DOCTOR_COORDINATOR
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  primaryRole  RoleName   @map("primary_role")
  lastLoginAt  DateTime?  @map("last_login_at")

  userRoles UserRole[]
  patient   Patient?
  orgStaff  OrgStaff[]
  auditLogs AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  userRoles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model UserRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Address {
  id String @id @default(uuid())

  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String? @map("postal_code")
  country    String
  latitude   Float?
  longitude  Float?

  patients  Patient[]
  hospitals Hospital[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("addresses")
}

model Patient {
  id String @id @default(uuid())

  userId                String    @unique @map("user_id")
  fullName              String    @map("full_name")
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?
  phone                 String?
  primaryAddressId      String?   @map("primary_address_id")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  medicalHistory        String?   @map("medical_history")
  allergies             String?
  currentMedications    String?   @map("current_medications")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAddress Address? @relation(fields: [primaryAddressId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("patients")
}

model Hospital {
  id String @id @default(uuid())

  name          String
  legalName     String?        @map("legal_name")
  addressId     String?        @map("address_id")
  contactPhone  String?        @map("contact_phone")
  contactEmail  String?        @map("contact_email")
  licenseNumber String?        @map("license_number")
  status        HospitalStatus @default(PENDING)
  timeZone      String?        @map("time_zone")

  address     Address?             @relation(fields: [addressId], references: [id])
  departments HospitalDepartment[]
  staff       OrgStaff[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("hospitals")
}

model HospitalDepartment {
  id String @id @default(uuid())

  hospitalId  String  @map("hospital_id")
  name        String
  description String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([hospitalId, name])
  @@map("hospital_departments")
}

model OrgStaff {
  id String @id @default(uuid())

  userId     String       @map("user_id")
  hospitalId String       @map("hospital_id")
  staffRole  OrgStaffRole @map("staff_role")
  isActive   Boolean      @default(true) @map("is_active")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, hospitalId])
  @@map("org_staff")
}

model AuditLog {
  id String @id @default(uuid())

  userId     String? @map("user_id")
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  ipAddress  String? @map("ip_address")
  metadata   Json?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
